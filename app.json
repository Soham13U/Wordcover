{
  "expo": {
    "name": "Wordcover",
    "slug": "undercover",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "undercover",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.wordcover.app",
      "adaptiveIcon": {
        "backgroundColor": "#f6f1e7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Outfit",
                "fontDefinitions": [
                  { "path": "node_modules/@expo-google-fonts/outfit/400Regular/Outfit_400Regular.ttf", "weight": 400 },
                  { "path": "node_modules/@expo-google-fonts/outfit/500Medium/Outfit_500Medium.ttf", "weight": 500 },
                  { "path": "node_modules/@expo-google-fonts/outfit/600SemiBold/Outfit_600SemiBold.ttf", "weight": 600 },
                  { "path": "node_modules/@expo-google-fonts/outfit/700Bold/Outfit_700Bold.ttf", "weight": 700 }
                ]
              },
              {
                "fontFamily": "Fraunces",
                "fontDefinitions": [
                  { "path": "node_modules/@expo-google-fonts/fraunces/400Regular/Fraunces_400Regular.ttf", "weight": 400 },
                  { "path": "node_modules/@expo-google-fonts/fraunces/700Bold/Fraunces_700Bold.ttf", "weight": 700 },
                  { "path": "node_modules/@expo-google-fonts/fraunces/400Regular_Italic/Fraunces_400Regular_Italic.ttf", "weight": 400, "style": "italic" },
                  { "path": "node_modules/@expo-google-fonts/fraunces/700Bold_Italic/Fraunces_700Bold_Italic.ttf", "weight": 700, "style": "italic" }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "node_modules/@expo-google-fonts/outfit/400Regular/Outfit_400Regular.ttf",
              "node_modules/@expo-google-fonts/outfit/500Medium/Outfit_500Medium.ttf",
              "node_modules/@expo-google-fonts/outfit/600SemiBold/Outfit_600SemiBold.ttf",
              "node_modules/@expo-google-fonts/outfit/700Bold/Outfit_700Bold.ttf",
              "node_modules/@expo-google-fonts/fraunces/400Regular/Fraunces_400Regular.ttf",
              "node_modules/@expo-google-fonts/fraunces/700Bold/Fraunces_700Bold.ttf",
              "node_modules/@expo-google-fonts/fraunces/400Regular_Italic/Fraunces_400Regular_Italic.ttf",
              "node_modules/@expo-google-fonts/fraunces/700Bold_Italic/Fraunces_700Bold_Italic.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f1e7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5be844c0-b76a-4be5-bfee-28c8611d20ad"
      }
    }
  }
}
